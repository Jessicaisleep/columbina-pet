// dsh-genshin-pet 配置（JSONC：允许 // 和 /* */ 注释）
// 说明：浏览器端启动时通过 /dsh-pet-7340/config 拉取（本文件名是 config.jsonc，宿主路由不带后缀）；
//       字段缺失/写错会取内置默认值并告警（结构性缺失静默、显式写错告警），返回给消费端的永远是填满的成品。
//
// ============================================================================
// 这个文件现在只承载**全局默认值**，不再定义任何宠物。
// ============================================================================
// 两只角色（哥伦比娅 / 纳西妲）都是随包分发的 **pet pack**，各自完整定义在
//   assets/pet/columbina-config.json + assets/pet/columbina-animation/
//   assets/pet/nahida-config.json    + assets/pet/nahida-animation/
// 它们自带人设、动作池、权重、尺寸、初始位置——本文件里写的条目级字段（animations /
// animationWeights / whisperPrompt / memes / workStatusTexts）只是**合并基座**：
// 某个 pet pack 没写那一项时才会用到这里这份。想改某只角色的动作或人设，改它自己的
// config 文件（或把同名前缀的副本放到 $DSH_HOME/dsh-pet/pet/ 下覆盖，用户层优先）。
//
// 字段归属（三层）：
//   · 实例级（写在 pets[] 里，每只独立）：name / id / size / balanceEnabled / whisperEnabled /
//     workStatusEnabled / fixedEnabled / display / position，外加可选的 whisperPrompt（人设）
//   · 全局默认（本文件是默认值；用户在 main-config.jsonc 里写一次就对**所有宠物**生效，
//     含 pet/<名>-config.json 定义的种类；种类文件自己写了则覆盖自己那份）：
//     physics / font / confineToScreen / whisperImageEnabled / chatImageEnabled / chatImageLimit /
//     chatMemoryRounds / whisperModel / chatModel / eventsRefreshSec
//   · 条目级（每个条目一份；种类文件顶层可覆盖）：
//     whisperPrompt / memes / workStatusTexts / animations / animationWeights
//   · 只读 main（写了也只认 main 条目那份）：notificationsEnabled / eventsRefreshSec.balance
// 合并口径：所有顶层字段都是**整段替换**——写了就整段用自己的，缺的子键不会从本文件补回来
//   （消费端各自兜底：余额周期读不到按 1800、碎碎念按 300）。
{
  // ===================== 碎碎念 / 对话的人设（合并基座） =====================
  // 两只角色各自在自己的 pet pack 里写了完整人设，会**整段取代**这里这份；
  // 这里只兜一个中性默认值：万一将来新增的 pet pack 忘了写人设，也不至于空着。
  // 只写正文：实际发给模型的 system = 这段 + 自动追加的「你的名字是“<宠物名>”。」+ 当前时间背景
  // （日期/星期/时刻/时段/工作日或周末/节日）——所以别在这里再写名字和日期。人设**没有长度上限**。
  "whisperPrompt": "你是主人桌面上的一个小家伙，会时不时碎碎念一句。说话要自然随意、短短一句（20字以内），说人话不啰嗦，不要解释你自己，不要提你是AI。",
  // ===================== 对话记忆轮数（全局默认；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 右键菜单「对话」弹窗与桌宠聊天时，每次请求携带的最近历史轮数（1 轮 = 1 问 1 答）。
  // memory.json 全存不删，此值只决定"每次请求截取多少进上下文"。非负数字；缺失默认 5，
  // 写了非法（负数/非数字）即配置错误。回落链同 whisperPrompt：种类文件顶层 → 全局 → 默认 5。
  // 设置页「AI 模型与对话上下文」区有数字输入框，改这里或那里等价（设置页写的是用户层）。
  "chatMemoryRounds": 5,
  // ===================== 碎碎念模型（全局默认：用户层写了对所有宠物生效；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 碎碎念用哪个服务商 + 模型生成。provider 与 model **都留空 = 跟随当前对话的模型**（默认，与旧行为一致）；
  // 想给后台自动跑的碎碎念单独用便宜/快的模型就填上（设置页有下拉框，选项与 DSH 的模型选择器同源）。
  // 只填一半（选了服务商没选模型，或反之）即配置错误 → 告警并取默认（跟随当前对话）。
  "whisperModel": { "provider": "", "model": "" },
  // ===================== 对话模型（全局默认；同上，留空 = 跟随当前对话） =====================
  // 右键菜单「对话」与桌宠聊天时用哪个服务商 + 模型。填了但调用失败（凭据被删 / 模型下架 /
  // 该服务商没配 key）会**自动回落到当前对话的模型重试一次**，仍失败才按生成失败报错。
  "chatModel": { "provider": "", "model": "" },
  // ===================== 表情包：碎碎念配图开关（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 开启后，碎碎念每次生成时从 memes 图片池随机抽 1 张，连同那句话一起显示（气泡配图）。
  // 碎碎念本身是"随口一句"，没有上下文可选，所以按随机抽（与对话的 AI 选图策略不同）。
  //
  // **本包默认关闭，并且不内置任何表情包图片**（0.3.x 那 27 张是上游「蓝毛小女仆」的梗图，
  // 与本包两只角色无关，已随角色一起移除）。想用就自己往 $DSH_HOME/dsh-pet/memes/ 放 png，
  // 再把下面的 memes 映射填上并把本开关打开——目录与键的对应关系见 memes 段注释。
  // 必填布尔值；缺失即配置错误。改动后刷新或重启生效。
  "whisperImageEnabled": false,
  // ===================== 表情包：对话配图开关（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 开启后，对话生成时把全部表情包（名称 + 描述）交给模型，由它按当前语境选 1 张；
  // 模型不选或选了不存在的图则不配图（对话配图是可选点缀，不强制每句都带）。
  // **本包默认关闭**（理由同上：池子默认是空的，开着只会白烧 token）。必填布尔值，缺失即配置错误。
  "chatImageEnabled": false,
  // ===================== 表情包：对话配图张数上限（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 对话时发给模型的表情包清单**最多几张**（「前 N 张」= 配置里**写在前面的那 N 条**）。
  // 为什么要有它：这张清单是**每条消息都要附**的，token 随图片数量线性增长——
  // 限制成前 N 张，模型只从这几张里挑，费用上限立刻可控。
  // 非负整数；0 = 不限制（全部发）。只影响对话选图：碎碎念只带抽中的那一张，与本项无关。
  "chatImageLimit": 10,
  // ===================== 表情包：图片映射（名称 → 描述，模型据此选图） =====================
  // 键 = <表情包目录>/<键>.png 的文件名（不含扩展名）；值 = 该图内容的简要描述。
  // 查找目录：pet/<素材根>-memes/ 存在就只查它；否则 $DSH_HOME/dsh-pet/memes/ → 包内 assets/memes/。
  // 要求：键必须与目录下的 png 文件名一一对应（文件缺失即该条失效并告警）；值为非空字符串。
  // 本包**默认空**（不内置图片）。加图后照样填写即可，例如：
  //   "memes": { "摸鱼": "躺在键盘上不想动，适合偷懒、收工、不想干活" }
  "memes": {},
  // ===================== 系统通知总开关 =====================
  // 对话完成 / 生成失败 / 输出截断 / 权限申请 / 用户选择 在窗口失焦时弹出系统级通知（桌面右下角）。
  // 不需要时改为 false（修改后刷新或重启生效）。必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.jsonc）顶层覆盖，设置页保存宠物时会保留该字段。
  // 只读 main 条目这一份。
  "notificationsEnabled": true,
  // ===================== 点击音效开关 =====================
  // true = 点一下宠物播一声内置音效（assets/sound/click-duck.wav，音量固定 0.5；
  //   100ms 内的连续点击只响一次，多开时也不会叠成一片）。
  // false（默认）= 完全静音——新增音效不突袭既有用户，想听的人自己去设置页打开。
  // 必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.jsonc）顶层覆盖，设置页「全局开关」里的开关写的就是它。
  // 只读 main 条目这一份（pet pack 种类文件不单独覆盖），改动后保存即生效。
  "clickSoundEnabled": false,
  // ===================== 锁定在当前屏幕（根字段，不属于 physics） =====================
  // 多屏用户：true = 宠物只在**当前所在那块屏幕**内活动——
  //   抛掷：只在松手时所在那块屏内弹（屏缝当墙，不飞到隔壁屏）；
  //   漫游：只在当前所在那块屏内走，越出屏缝的那一步直接取消（抛掷是逐帧物理边界，会撞回来；
  //         漫游是一次性落点规划、没有反弹语义，走不过去就不发车）。
  // false（默认）= 屏缝两侧都有屏时照常跨屏飞行 / 跨屏行走、落到隔壁屏（现状）。
  // 必填布尔值，缺失即配置错误；也可在用户配置（main-config.jsonc）顶层覆盖，设置页开关写的就是它。
  // 全局默认：用户层写一次对**所有宠物**生效（含种类）；种类文件 pet/<名>-config.json 顶层写了则用自己那份。
  // 仅影响桌面模式（浏览器 overlay 本来就只在视口内活动）。改动后刷新或重启生效。
  "confineToScreen": false,
  // ===================== 系统托盘（仅桌面模式） =====================
  // 桌面模式启动后在通知区域（Windows）/ 菜单栏（macOS）常驻一个图标：列出配置里的**全部**宠物，
  // 勾选即可切换显示位置——包括 display 为 web / none（当前不在桌面、没有窗口可右键）的那些。
  // false = 不建托盘：不想在系统托盘留下痕迹，或同时跑多个桌面端 DSH（各占一个位置）时用。
  // 关掉的代价：桌面侧就没有「把不在桌面的宠物叫回桌面」的入口了，要开浏览器用设置页、
  // 或在网页端那只宠物身上右键切换。
  // 仅影响桌面模式（纯浏览器端本来就没有托盘）。必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.jsonc）顶层覆盖，设置页「全局开关」里的托盘开关写的就是它。
  // 改动后保存即生效（宿主会重启桌面 Helper，桌面宠物窗口会重建一次）。
  "trayEnabled": true,
  // ===================== 读屏上下文（全局，用户级） =====================
  // 是否让桌宠读「用户此刻在看的窗口」里的可见文字，作为碎碎念与对话的背景。
  // **默认关闭**：这是隐私开关，必须由用户在设置页显式打开。
  // 技术路径：常驻一个 PowerShell 子进程（runtime/electron-helper/uia-reader.ps1），
  //   通过 Windows UIAutomation 只取控件的 Name（可见文字）——**不截图、不读剪贴板、不记录键盘输入**。
  // 生效范围：只影响碎碎念与对话的 system 提示词（追加一段【用户此刻的屏幕】），不改任何其他行为。
  // 代价：每次抓取约 1 秒，且读到的内容会随请求发给你配置的 AI 服务商。介意就别开。
  "screenContextEnabled": false,
  // 读屏的窗口标题黑名单：字符串数组，每项是一个子串（大小写不敏感），命中就不读那个窗口。
  // 用途：把密码管理器、银行、私人聊天等窗口排掉。留空数组 = 不排除任何窗口。
  // 例：["1Password", "Bitwarden", "招商银行", "微信"]
  "screenExcludePatterns": [],
  // ===================== AI 助手（全局，用户级） =====================
  // 是否让对话走「助手模式」：桌宠会真的动手做事（列目录 / 读写文件 / 搜索网页），
  // 而不是只会聊天。**默认关闭**——它是把电脑的操作权交给模型，必须由用户显式打开。
  // 打开后：对话走多步工具循环（上限 8 步），**思考过程不可见**，你只看到最后那句带人设的回复。
  // 关掉后：对话恢复成普通闲聊，不会碰任何文件与网络。
  "assistantEnabled": false,
  // 助手权限档位，三选一（字符串）：
  //   "readonly"  只读    —— 能看工作区、能联网查资料，**不能写任何文件**（默认，最保守）
  //   "workspace" 工作区内 —— 能改工作区里的文件，越界要单独批准一次
  //   "full"      完全权限 —— 任意路径读写，**危险**，只在你清楚后果时用
  // 越权动作不会静默失败：会弹审批，你点允许后只放行「这一次、这个动作、这个路径」。
  "assistantPermission": "readonly",
  // 助手能否联网（web_search 搜网页 / fetch_url 抓网页正文）。
  // 与助手开关独立：可以允许改文件但禁网，也可以只让它查资料不许动文件。
  "assistantNetworkEnabled": true,
  // ===================== 工作状态联动文案（条目级，与 animations/physics 同级；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 工作状态气泡文本（pets[].workStatusEnabled 开启时展示；仅在 events.workStatus 动画触发时弹）。
  // 结构 = 二维数组，外层索引即档位（与 events.workStatus 动画索引一一对应，勿在中间插入新档）：
  //   0 thinking（turn/start）/ 1 working（tool/call）/ 2 result（tool/result）/
  //   3 waiting（approval/asked）/ 4 success（turn/end completed）/ 5 error（turn/end error/max-tokens）
  // 每档内是多个备选句，播放时随机抽一句（想固定单句就只写一个；想换文案只改这里）。
  // 省略整个字段 = 不弹工作状态气泡文本（仍播动画）；省略某档 = 该档不显示文本。
  "workStatusTexts": [
    ["正在认真想下一步呢", "让我整理一下思路~", "正在梳理接下来要做什么"],
    ["正在处理任务呢", "这一步正在进行中哦", "正在继续干活呢，别打扰我~"],
    ["这一步处理好啦，接着看下一步", "搞定一步，继续看看哦~"],
    ["需要你确认一下呢", "这里要等你看一下哦", "轮到你来决定啦，等你~"],
    ["这一轮搞定啦，真棒！", "任务完成咯，可以摸鱼啦~"],
    ["这一步好像没跑通呢", "刚才的操作遇到点问题哦", "这里卡了一下，再等等你呢"]
  ],
  // ===================== 宠物物理（拖拽抛掷手感，全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // gravity：抛掷下落/反弹的基础重力（px/s²）。默认 1400（数值越大落得越快）；0 = 无重力。
  // restitution：碰壁反弹恢复系数，0~1（1 = 完全弹性，0 = 撞上即停；墙/地共用）。默认 0.78。
  // groundFriction：落地时水平速度的衰减率（/s，0 = 无摩擦冰面）。默认 2.5。
  // ceilingBounce：顶部是否反弹。true = 碰顶反弹（现状）；false = 顶部无边界。
  // throwPower：总力度（拖拽/抛掷输出增益）。1.0 = 现状；必须 > 0。
  // petCollision：多宠物互相碰撞开关。true = 飞行中被甩出的宠物撞到其它宠物时按动量守恒弹开；
  //   false = 关闭（默认，宠物互相穿过）。本包默认两只角色同时在桌面，喜欢互动感可以开。
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": false
  },
  // ===================== 字体（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // family：字体种类（预设 id，必须在白名单内，写错即配置错误 → 告警并取默认 candy）。
  //   可选：candy=软糖体（内置，默认）/ yahei=微软雅黑·苹方 / youyuan=幼圆 / kaiti=楷体 /
  //   simsun=宋体 / comic=漫画体 / system=系统默认。
  //   各 id 对应的实际字体栈见 src/shared/fonts.ts 的 FONT_PRESETS。
  // size：字号 px，**只影响气泡与悬浮提示**（对话窗与得分弹窗字号不变）。范围 4~200，默认 21。
  // followPet：字号是否随宠物大小等比缩放。true（默认）= 按「实际 size ÷ 基准尺寸」缩放。
  // 注意（对象字段都是整段替换）：要写就三个子键写全——只写一半会被判为整段非法。
  "font": {
    "family": "candy",
    "size": 21,
    "followPet": true
  },
  // ===================== 默认宠物列表 =====================
  // **本包刻意留空**：两只角色都由 assets/pet/ 下的 pet pack 定义（它们各自带完整的
  // pets[]、人设、动作池），不再有任何「内置默认宠物」。
  //
  // 为什么留空而不是删掉这个键：合并器只遍历**本文件的**顶层键（host/config.ts 的 mergeEntry），
  // 少了这个键，pet pack 里的 pets 就无处安放。同理下面的 animations 也必须保留一个合法形状。
  //
  // 想加自己的宠物：照 MAKE-YOUR-OWN-PET.md 做一个 pet pack 放进 $DSH_HOME/dsh-pet/pet/
  // （用户层优先，同名会覆盖包内那份），或者在这里按下面的字段说明手写一条。
  //   name（显示名，可重复；省略按 id 处理）、id（唯一标识，冲突即配置错误）、
  //   size（宽度 px，高度自动 = size × 9/16）、balanceEnabled、whisperEnabled、
  //   workStatusEnabled、fixedEnabled、display（web/desktop/both/none）、
  //   position（corner + marginX/marginY）、可选 whisperPrompt（这只宠物自己的人设）
  "pets": [],

  // ===================== 动作动画池配置（合并基座） =====================
  // 两只角色各自的 animations 会**整段取代**这里这份（见各自 pet pack）。
  // 这里这份同时是主配置宠物（main = 蓝毛小女仆）真正用的池子 —— 它没有专属 pet pack，
  // 直接吃这里的名字。**每个名字必须与 assets/webm/ 下的文件名逐字相同（去掉 .webm）**：
  // 客户端按 `名字 + '.webm'` 精确拼 URL（src/client/pet.ts），宿主 findAnim 也只做精确查找，
  // 没有前缀匹配、没有模糊回退。写成「碎碎念」「待机」这类简称 → 404 + video error → 窗口空白。
  // （2026-10-31 修：此处原本是一组占位简称，导致蓝毛女仆窗口全黑不显示。）
  // 素材查找顺序：pet/<素材根>-animation/（存在则只查它）→ $DSH_HOME/dsh-pet/main-animation/<ext>/
  //   → 包内 assets/<ext>/。主配置宠物（main）没有专属目录，走后两级。
  "animations": {
    // 待机动画池（数组，可放多个，等概率抽）
    "idle": ["待机呼吸休闲"],
    // 转向动画池（数组；每一项都必须是"播完会翻转朝向"的动画，如东张西望）
    "turn": ["东张西望"],
    // 拖拽动画池（数组；每一项都必须是"被无形抓起悬空"的姿势）
    "drag": ["被鼠标拖拽悬空反馈"],
    // 点击回应动画池（点按宠物时触发，随机抽 1 个）
    "clicks": [
      "点击回应-开心跃动",
      "点击回应-害羞惊讶",
      "点击回应-傲娇生气",
      "点击回应-挠痒咯咯笑",
      "点击回应-元气挥手"
    ],
    // 移动动画池：default 是每个动作都用的默认参数；actions 里每项可覆盖部分参数，
    // 未写的字段取 default。minDist/maxDist=单次行进距离(px)——以「基准宠物宽 462px」为准，
    //   运行时按 实际size/462 等比缩放；margin=贴边安全距(px，不随缩放)、
    //   leadSec/tailSec=动画首尾各多少秒原地不动。
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "螃蟹走路" },
        { "name": "原地漂浮踏步", "params": { "minDist": 40, "maxDist": 120 } },
        { "name": "原地左转奔跑", "params": { "minDist": 120, "maxDist": 320, "leadSec": 1.75, "tailSec": 4.8 } }
      ]
    },
    // 随机动作：分类池。weight 为该分类出现权重；noMirror: true 表示"带文字、镜像会颠倒，
    // 宠物面向右（被镜像）时不播放该类"。所有分类 weight 合计应与 animationWeights 里
    // 顶层权重和的余量（100 − idle − turn − move）相等。
    "categories": [
      { "id": "小动作", "weight": 20, "actions": [
        "悠闲哼歌", "超大伸懒腰", "原地敲击桌面互动", "原地重力下蹲压缩", "哈欠连天",
        "原地小憩沉眠", "女仆屈膝礼仪", "被吓一跳", "小幅度原地360度旋转展示",
        "偷吃零食被抓住", "用鲸鱼尾巴拍打地面", "打瞌睡被惊醒", "照镜子", "整体换装试色",
        "轻快记录", "写代码", "摇扇纳凉", "晨间刷牙"
      ] },
      { "id": "玩耍", "weight": 20, "actions": [
        "原地专心玩魔方", "原地蹲下玩玩具汽车", "鲸鱼吐泡泡特效", "原地跳跃抓碎头顶物品",
        "玩游戏气急败坏", "玩水枪", "小提琴演奏", "蓝鲸现世", "优雅女仆舞", "轻快摇摆舞",
        "可爱宅舞", "吹气球", "动物环绕", "放风筝", "拆礼物", "变鸽子", "扑克魔术",
        "抽陀螺", "吹笛子", "蝴蝶蜜蜂环绕头顶开花", "撸猫", "凭空生花", "骑木马",
        "三球抛接", "踢毽子", "下五子棋", "荡秋千"
      ] },
      { "id": "吃什么", "weight": 16, "actions": [
        "吃白饭", "大口吃零食", "吃Token", "吃早餐", "吃午餐", "吃晚餐", "吃冰淇淋融化",
        "吃大闸蟹", "吃糖葫芦", "吃长寿面", "吃西瓜", "涮火锅"
      ] },
      { "id": "时节", "weight": 14, "actions": [
        "被落叶淹没", "中秋赏月吃月饼", "堆雪人", "放烟花", "吃粽子", "吃年糕", "吃青团",
        "吃腊八粥", "吃重阳糕", "收红包", "写福字", "穿针乞巧", "舞狮头", "讨糖南瓜灯",
        "插茱萸赏菊", "放河灯", "萌化小幽灵", "装点圣诞树", "放孔明灯", "吃汤圆", "吃饺子"
      ] },
      { "id": "文字", "weight": 10, "noMirror": true, "actions": [
        "是啊，吃什么", "深度思考碎碎念"
      ] }
    ],
    // 事件动画：不进随机链（rollKind/pickNext 不会抽到），只由代码显式触发。
    // events.<事件名> 为档位数组，按「事件档位」顺序排列（索引即档位）。
    "events": {
      "balance": [
        "余额-钱袋满溢",   // 0 ≤ p < 20（几乎未消耗）
        "余额-金袋叮当",   // 20 ≤ p < 40
        "余额-钱袋如常",   // 40 ≤ p < 60
        "余额-数金皱眉",   // 60 ≤ p < 80
        "余额-袋空如洗",   // 80 ≤ p < 100（告急）
        "余额-分文不剩"    // p === 100（全部用完，格外档）
      ],
      // 碎碎念：到点随机抽 1 段播（等概率），与 eventsRefreshSec.whisper 周期对应
      "whisper": [
        "碎碎念-擦桌碎碎念",
        "碎碎念-发呆碎碎念",
        "碎碎念-对屏碎碎念"
      ],
      // 工作状态联动（pets[].workStatusEnabled 开启时）：按索引 = 状态档位，勿在中间插入新档
      "workStatus": [
        "工作状态-思考冒泡",      // index 0 thinking（turn/start 回合开）
        "工作状态-忙碌点按",      // index 1 working（tool/call 工具调用）
        "工作状态-清点归档",      // index 2 result（tool/result 工具完成回整理）
        "工作状态-原地踱步张望",  // index 3 waiting（approval/asked 等待批准）
        "工作状态-雀跃庆祝",      // index 4 success（turn/end completed 完成）
        "工作状态-垂头叹气冒汗"   // index 5 error（turn/end error/max-tokens 出错/达上限）
      ]
    }
  },

  // ===================== 事件触发周期（全局默认：用户层写一次对所有宠物生效，种类文件顶层可覆盖） =====================
  // 事件名 → 刷新间隔（秒）。**整段替换**：写了就整段用自己的，缺的键不会从内置默认补回来。
  //   · whisper：碎碎念周期，按宠物所属条目读（种类可覆盖）；读不到按 300 兜底。
  //   · balance：余额数据刷新 + 余额动画触发的间隔，**消费端只读 main 条目**；读不到按 1800 兜底。
  // 非法数值（非正数/非数字）即整段配置错误 → 告警并回退内置默认。
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300
  },

  // ===================== 主动聊天（全局默认，2026-10-31 新增） =====================
  // 与碎碎念的分水岭（两者都会弹气泡，但语义完全不同）：
  //   · 碎碎念 = 自言自语，**不进记忆**——下次对话时它不记得自己嘀咕过什么；
  //   · 主动聊天 = 真的开启一轮对话，**写进记忆**——你回一句「哈哈」它接得上。
  // 判定还有一条硬边界：**她欠你一个回复时不会主动开口**（上一轮是 user 消息）。
  // 否则会出现"你问了它没答，它却自顾自说起来"这种最让人恼火的情形。
  //
  // ⚠ 这两个键必须同时出现在三个地方，少一处就静默失效：
  //   ① 本文件（mergeEntry 只遍历这里的顶层键——用户层写了但这里没有的键**根本进不了 merged main**）
  //   ② src/host/config.ts 的 GLOBAL_DEFAULT_KEYS（决定 pet pack 条目能否继承到，packBase 用它）
  //   ③ src/host/config.ts 的 topFieldValid（非法值兜底 + 设置页保存校验）
  "proactiveChatEnabled": false,
  // 间隔秒数，范围 120 ~ 86400（最短 2 分钟，最长一天）。越界**不夹紧**而是回落默认 1800：
  // 夹紧会让手写 10 秒的人静默变成 120 秒，还不如按默认走。每只宠物各算各的计时。
  "proactiveChatSec": 1800,

  // ===================== 动画链顶层权重（合并基座） =====================
  // idle/turn/move 的权重 + 上面各分类 weight 合计 = 100
  // 注：宠物开了 pets[].fixedEnabled（宠物固定）时，turn/move 两档权重按 0 算（抽不到），
  //     它们的份额自然落到「随机小动作」。
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  }
}
